# Copy to .env and fill in. Never commit .env.
# Without keys, `make film` still rebuilds the film from cached outputs/.

# Google AI Studio: script, translation, backup TTS
GEMINI_API_KEY=

# Addis AI: primary Amharic TTS (https://platform.addisassistant.com)
ADDIS_API_KEY=

# Cloudflare Workers AI: keyframes (FLUX.2 klein 4B)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Kaggle credentials live in ~/.kaggle/kaggle.json (not here)
KAGGLE_USERNAME=
